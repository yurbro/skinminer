# OpenAI API credential. Create a key in the OpenAI platform dashboard.
OPENAI_API_KEY=your-key-here

# Anthropic API credential. Required only when selecting the Anthropic provider.
ANTHROPIC_API_KEY=your-key-here

# Contact email sent to Unpaywall. Register or review API use at unpaywall.org/products/api.
UNPAYWALL_EMAIL=

# Contact email used by Europe PMC and NCBI-oriented scouting utilities.
NCBI_EMAIL=

# Optional override for the Round-2 gold CSV used by evaluation regression tests.
SKINMINER_ROUND2_GOLD=

# Optional override for the sanitized provider-policy aggregate used by evaluation tests.
SKINMINER_PROVIDER_METRICS=

